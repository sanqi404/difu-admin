# ============================================================
# 地府幽冥政务中台 · 环境变量示例
# 使用方式：复制本文件为 .env 后按需修改
#   cp .env.example .env
# 同名配置项优先级：环境变量 > .env > app/config.py 默认值
# ============================================================

# ---------- 运行通道 ----------
# dev   = 本地开发（SQLite + 内存缓存）
# prod  = 生产（MySQL + Redis，需同时填 DATABASE_URL / CACHE_BACKEND / REDIS_URL）
ENV_MODE=dev
DEBUG=true

# ---------- 数据库 ----------
# 留空则按 ENV_MODE 自动取默认值：
#   dev  -> sqlite+aiosqlite:///./data/difu_dev.db
#   prod -> MySQL（见 app/config.py 的 PROD_DATABASE_URL）
# 显式指定 MySQL 示例（请替换为真实账号密码）：
#   DATABASE_URL=mysql+pymysql://<db_user>:<db_password>@<db_host>:3306/<db_name>?charset=utf8mb4
DATABASE_URL=
DB_ECHO=false

# ---------- 缓存 ----------
# 留空则 dev 用 memory、prod 用 redis；可选值：memory / redis
CACHE_BACKEND=
# Redis 连接串（CACHE_BACKEND=redis 时必填），请替换为实际地址
REDIS_URL=redis://127.0.0.1:6379/3
CACHE_PREFIX=difu

# ---------- 鉴权 ----------
# 必须替换为随机长字符串（建议 >= 32 位），切勿使用示例值上线
JWT_SECRET=change-me-to-a-random-long-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# ---------- 验证码 ----------
CAPTCHA_LENGTH=4
CAPTCHA_EXPIRE_SECONDS=120
# 仅开发环境生效的固定验证码，生产请留空
CAPTCHA_DEV_CODE=0000

# ---------- 跨域 ----------
# 多个来源用英文逗号分隔
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- 初始化账号 ----------
# 仅 app/seed.py 初始化基础数据时使用，请替换为自定义密码
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=change-me-admin-password

# ---------- 可选 ----------
# 应用名称，留空使用 app/config.py 默认值
# APP_NAME=地府幽冥政务中台
